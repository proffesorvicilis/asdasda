 "lines": [
  {
   "id": "L01",
   "sc": "varis",
   "s": 0.3,
   "e": 3.414,
   "text": "Seni adaya bırakan balıkçı, iskeleye yanaşmadı bile.",
   "hl": {
    "yanaşmadı": "r"
   }
  },
  {
   "id": "L02",
   "sc": "varis",
   "s": 3.594,
   "e": 7.067,
   "text": "Erzakını kayalara attı. Arkasına bakmadan gitti.",
   "hl": {
    "bakmadan": "r"
   }
  },
  {
   "id": "L03",
   "sc": "genis",
   "s": 7.247,
   "e": 11.882,
   "text": "Kuzgun Adası. Yedi gece. Bir fener, bir de sen.",
   "hl": {
    "kuzgun": "a",
    "adası.": "a",
    "yedi": "y",
    "gece.": "y"
   }
  },
  {
   "id": "L04",
   "sc": "riza_eski",
   "s": 12.382,
   "e": 15.383,
   "text": "Bu feneri kırk bir yıl boyunca Rıza Usta yaktı.",
   "hl": {
    "kırk": "y",
    "bir": "y",
    "yıl": "y",
    "rıza": "a",
    "usta": "a"
   }
  },
  {
   "id": "L05",
   "sc": "iskele_safak",
   "s": 15.563,
   "e": 18.252,
   "text": "Geçen ay bir sabah, onu iskelede buldular.",
   "hl": {
    "iskelede": "y"
   }
  },
  {
   "id": "L07",
   "sc": "iskele_safak",
   "s": 18.432,
   "e": 20.045,
   "text": "Sadece sayıyordu.",
   "hl": {
    "sayıyordu.": "r"
   }
  },
  {
   "id": "L08",
   "sc": "riza_yakin",
   "s": 20.345,
   "e": 23.337,
   "text": "Bir... iki... üç...",
   "hl": {
    "üç...": "r"
   }
  },
  {
   "id": "L09",
   "sc": "safak_sonuk",
   "s": 23.787,
   "e": 25.663,
   "text": "O sabah, fener sönüktü.",
   "hl": {
    "sönüktü.": "r"
   }
  },
  {
   "id": "L10",
   "sc": "oda",
   "s": 26.263,
   "e": 28.214,
   "text": "Kuralları hâlâ duvarda asılı.",
   "hl": {}
  },
  {
   "id": "L11",
   "sc": "kurallar",
   "s": 28.514,
   "e": 33.009,
   "text": "Birinci kural: Fener gün batımında yanar. Arada asla sönmez.",
   "hl": {
    "asla": "r",
    "sönmez.": "r"
   }
  },
  {
   "id": "L12",
   "sc": "kurallar",
   "s": 33.359,
   "e": 37.374,
   "text": "İkinci kural: Sis gelirse, düdüğü beş dakikada bir çal.",
   "hl": {
    "beş": "y",
    "dakikada": "y"
   }
  },
  {
   "id": "L13",
   "sc": "kurallar",
   "s": 37.724,
   "e": 41.78,
   "text": "Üçüncü kural: Denizden bir düdük cevap verirse... say.",
   "hl": {
    "cevap": "r",
    "say.": "y"
   }
  },
  {
   "id": "L14",
   "sc": "kurallar",
   "s": 42.13,
   "e": 46.626,
   "text": "Dördüncü kural: Üçüncü cevapta feneri söndür. Sabaha kadar yakma.",
   "hl": {
    "üçüncü": "y",
    "cevapta": "y",
    "söndür.": "r"
   }
  },
  {
   "id": "L15",
   "sc": "kurallar",
   "s": 47.026,
   "e": 49.824,
   "text": "Beşinci kural, başka bir mürekkeple yazılmış.",
   "hl": {
    "başka": "a"
   }
  },
  {
   "id": "L16",
   "sc": "kurallar",
   "s": 50.074,
   "e": 52.628,
   "text": "Ben gelip kapıyı çalarsam... açma.",
   "hl": {
    "açma.": "r"
   }
  },
  {
   "id": "L17",
   "sc": "yakma",
   "s": 53.328,
   "e": 55.741,
   "text": "Gün batıyor. Feneri yakıyorsun.",
   "hl": {
    "yakıyorsun.": "y"
   }
  },
  {
   "id": "L18",
   "sc": "sis",
   "s": 56.541,
   "e": 58.881,
   "text": "Gece ikiye doğru, sis geliyor.",
   "hl": {
    "sis": "y"
   }
  },
  {
   "id": "L19",
   "sc": "duduk1",
   "s": 59.381,
   "e": 61.028,
   "text": "Düdüğü çalıyorsun.",
   "hl": {
    "çalıyorsun.": "y"
   }
  },
  {
   "id": "L20",
   "sc": "cevap1",
   "s": 65.108,
   "e": 67.649,
   "text": "Denizden, bir düdük cevap veriyor.",
   "hl": {
    "cevap": "r"
   }
  },
  {
   "id": "L21",
   "sc": "cevap1",
   "s": 67.899,
   "e": 68.735,
   "text": "Bir.",
   "hl": {
    "bir.": "r"
   }
  },
  {
   "id": "L22",
   "sc": "duduk2",
   "s": 69.335,
   "e": 71.608,
   "text": "Beş dakika sonra, yine çalıyorsun.",
   "hl": {
    "yine": "y"
   }
  },
  {
   "id": "L23",
   "sc": "cevap2",
   "s": 75.388,
   "e": 75.962,
   "text": "İki.",
   "hl": {
    "iki.": "r"
   }
  },
  {
   "id": "L24",
   "sc": "cevap2",
   "s": 76.162,
   "e": 78.022,
   "text": "Bu sefer daha yakından.",
   "hl": {
    "yakından.": "r"
   }
  },
  {
   "id": "L25",
   "sc": "cevap2",
   "s": 78.372,
   "e": 80.769,
   "text": "Bu bir yankı değil. Yankı beklemez.",
   "hl": {
    "yankı": "y",
    "beklemez.": "r"
   }
  },
  {
   "id": "L26",
   "sc": "duduk3",
   "s": 81.269,
   "e": 82.676,
   "text": "Üçüncü kez çalıyorsun.",
   "hl": {
    "üçüncü": "y"
   }
  },
  {
   "id": "L27",
   "sc": "cevap3",
   "s": 88.056,
   "e": 88.85,
   "text": "Üç.",
   "hl": {
    "üç.": "r"
   }
  },
  {
   "id": "L28",
   "sc": "kural4",
   "s": 89.55,
   "e": 91.539,
   "text": "Dördüncü kural: Feneri söndür.",
   "hl": {
    "söndür.": "r"
   }
  },
  {
   "id": "L29",
   "sc": "tekne",
   "s": 91.939,
   "e": 96.284,
   "text": "Ama sisin içinde ışıklar var. Bir tekne, kayalara doğru geliyor.",
   "hl": {
    "ışıklar": "y",
    "kayalara": "r"
   }
  },
  {
   "id": "L30",
   "sc": "salter",
   "s": 96.634,
   "e": 99.285,
   "text": "Fener sönerse, kayaları göremezler.",
   "hl": {
    "göremezler.": "r"
   }
  },
  {
   "id": "L31",
   "sc": "secim",
   "s": 99.785,
   "e": 102.841,
   "text": "Üçüncü cevap geldi. Feneri söndürüyor musun?",
   "hl": {
    "söndürüyor": "r",
    "musun?": "r"
   }
  }
