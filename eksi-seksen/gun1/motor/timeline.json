{
 "duration": 143.384,
 "fps": 30,
 "lines": [
  {
   "id": "L01",
   "sc": "yatak",
   "v": "N",
   "s": 0.2,
   "e": 3.357,
   "text": "On sekiz Aralık sabahı alarmın çaldığında, yerler buz gibiydi.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L02",
   "sc": "yatak",
   "v": "N",
   "s": 3.557,
   "e": 8.63,
   "text": "Pencerenin kenarları buz tutmuştu. Telefon sıfır dereceyi gösteriyordu. Dün artı ondu.",
   "hl": {
    "sıfır": "y",
    "artı": "y",
    "ondu.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L03",
   "sc": "mutfak",
   "v": "N",
   "s": 8.83,
   "e": 11.633,
   "text": "On derece düşmüş. Kahveni koyup televizyonu açtın.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L04",
   "sc": "tv_haber",
   "v": "SPIKER",
   "s": 12.633,
   "e": 15.712,
   "text": "Sibirya kaynaklı soğuk hava dalgası etkisini artırıyor.",
   "hl": {},
   "col": null,
   "etiket": "HABER",
   "pre": 0.12
  },
  {
   "id": "L05",
   "sc": "mutfak2",
   "v": "N",
   "s": 15.912,
   "e": 17.81,
   "text": "Kış işte, dedin. Ankara'nın ayazı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L06",
   "sc": "park",
   "v": "N",
   "s": 18.01,
   "e": 22.727,
   "text": "Sabah koşusuna çıktın. Parktaki havuz buz tutmuştu. Ağaçlarda tek bir kuş yoktu.",
   "hl": {
    "kuş": "r",
    "yoktu.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L07",
   "sc": "park",
   "v": "N",
   "s": 22.927,
   "e": 27.315,
   "text": "Güneş tepedeydi ama yüzünü ısıtmıyordu. Soluk, eski bir ampul gibiydi.",
   "hl": {
    "ısıtmıyordu.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L08",
   "sc": "kafe",
   "v": "N",
   "s": 27.515,
   "e": 30.772,
   "text": "Öğlen bir kafede bilgisayarını açtın. Herkes soğuktan bahsediyordu.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L09",
   "sc": "telefon_app",
   "v": "N",
   "s": 30.972,
   "e": 37.868,
   "text": "Hava durumu uygulaması önümüzdeki günler için tuhaf rakamlar gösteriyordu. Eksi on. Eksi yirmi. Eksi otuz.",
   "hl": {
    "eksi": "r",
    "on.": "r",
    "yirmi.": "r",
    "otuz.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L10",
   "sc": "kafe2",
   "v": "N",
   "s": 38.068,
   "e": 40.312,
   "text": "Masadakiler güldü. Uygulama bozulmuş.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L11",
   "sc": "eczane",
   "v": "N",
   "s": 40.512,
   "e": 45.234,
   "text": "Saat birde termometre hâlâ sıfırdı. Öğlen olmasına rağmen bir derece bile yükselmemişti.",
   "hl": {
    "sıfırdı.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L12",
   "sc": "haber_bandi",
   "v": "N",
   "s": 45.434,
   "e": 50.881,
   "text": "Haber bandında bir satır geçti: Avrupa'da, Asya'da, Amerika'da aynı anda ani soğuma.",
   "hl": {
    "aynı": "r",
    "anda": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L13",
   "sc": "haber_bandi",
   "v": "N",
   "s": 51.081,
   "e": 53.953,
   "text": "Soğuk hava dalgası dünyanın her yerine aynı anda gelmez.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L14",
   "sc": "tel_aras",
   "v": "N",
   "s": 54.153,
   "e": 56.518,
   "text": "Aras'ı aradın. Kızılcahamam'daki çiftlikteydi.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L15",
   "sc": "tel_aras",
   "v": "ARAS",
   "s": 57.618,
   "e": 61.111,
   "text": "Kanka, burada da sıfır. Dün on ikiydi. Bir de garip bir şey var.",
   "hl": {},
   "col": null,
   "etiket": "ARAS · TELEFON",
   "pre": 0.12
  },
  {
   "id": "L16",
   "sc": "tel_aras",
   "v": "ARAS",
   "s": 61.311,
   "e": 66.379,
   "text": "Gökyüzü masmavi ama güneş panelleri yarı yarıya az üretiyor. Güneş sanki kısılmış.",
   "hl": {
    "kısılmış.": "r"
   },
   "col": null,
   "etiket": "ARAS · TELEFON",
   "pre": 0.12
  },
  {
   "id": "L17",
   "sc": "ciftlik",
   "v": "N",
   "s": 66.579,
   "e": 70.385,
   "text": "Aras ve Çınar'la birlikte bir akıllı tarım şirketi kurmuştunuz. İkisi de mühendis.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L18",
   "sc": "ciftlik",
   "v": "N",
   "s": 70.585,
   "e": 74.742,
   "text": "Şirketi iki yıl önce sattın. Deneme çiftliğini satmadın. Aras hâlâ orada.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L19",
   "sc": "foto",
   "v": "N",
   "s": 74.942,
   "e": 77.987,
   "text": "Üçünüzün de kimsesi yok. Sadece birbiriniz varsınız.",
   "hl": {
    "birbiriniz": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L20",
   "sc": "tel_cinar",
   "v": "N",
   "s": 78.187,
   "e": 78.92,
   "text": "Çınar'ı aradın.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L21",
   "sc": "tel_cinar",
   "v": "CINAR",
   "s": 79.92,
   "e": 83.64,
   "text": "Kanka, ben de tam seni arayacaktım. Bu soğuk normal değil, değil mi?",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR · TELEFON",
   "pre": 0.12
  },
  {
   "id": "L22",
   "sc": "tel_cinar",
   "v": "N",
   "s": 83.84,
   "e": 85.28,
   "text": "Akşam bana gel, dedin.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L23",
   "sc": "kapi",
   "v": "N",
   "s": 86.28,
   "e": 89.898,
   "text": "Çınar yedide kapıdaydı. Elinde iki poşet, bir de düdüklü tencere.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L24",
   "sc": "kapi",
   "v": "CINAR",
   "s": 90.098,
   "e": 93.883,
   "text": "Senin buzdolabında yumurtayla yoğurttan başka bir şey olmadığını biliyorum.",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR",
   "pre": 0.12
  },
  {
   "id": "L25",
   "sc": "mutfak_aksam",
   "v": "N",
   "s": 94.083,
   "e": 99.355,
   "text": "Mercimek çorbasının kokusu bütün evi sardı. Aras görüntülü aramadaydı, çiftlikteki sobanın başından.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L26",
   "sc": "tv_aksam",
   "v": "N",
   "s": 99.755,
   "e": 104.72,
   "text": "Akşam haberleri hâlâ soğuk hava dalgası diyordu. Ama Aras'ın grafiği başka bir şey söylüyordu.",
   "hl": {
    "grafik": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L27",
   "sc": "grafik",
   "v": "ARAS",
   "s": 104.92,
   "e": 110.446,
   "text": "Çiftliğin hava istasyonu bütün gün güneşi ölçtü. Gökyüzü açık ama gelen ışık normalin yarısı.",
   "hl": {
    "yarısı.": "r"
   },
   "col": null,
   "etiket": "ARAS · GÖRÜNTÜLÜ",
   "pre": 0.12
  },
  {
   "id": "L28",
   "sc": "grafik",
   "v": "ARAS",
   "s": 110.646,
   "e": 112.551,
   "text": "Ve her saat biraz daha azalıyor.",
   "hl": {
    "azalıyor.": "r"
   },
   "col": null,
   "etiket": "ARAS · GÖRÜNTÜLÜ",
   "pre": 0.12
  },
  {
   "id": "L29",
   "sc": "masa",
   "v": "CINAR",
   "s": 112.751,
   "e": 114.488,
   "text": "Güneş azalırsa ne olur?",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR",
   "pre": 0.12
  },
  {
   "id": "L30",
   "sc": "hesap",
   "v": "N",
   "s": 114.688,
   "e": 119.192,
   "text": "Hesabı yüksek sesle yaptın. Güneş kısılırsa dünya her gün biraz daha soğur.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L31",
   "sc": "hesap",
   "v": "N",
   "s": 119.392,
   "e": 123.132,
   "text": "Bugün on derece düştü. Yarın bir on derece daha.",
   "hl": {
    "yarın": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L32",
   "sc": "aras_video",
   "v": "ARAS",
   "s": 123.332,
   "e": 124.972,
   "text": "Bu bir hava olayı değil kanka.",
   "hl": {},
   "col": null,
   "etiket": "ARAS · GÖRÜNTÜLÜ",
   "pre": 0.12
  },
  {
   "id": "L33",
   "sc": "tv_aksam2",
   "v": "N",
   "s": 125.172,
   "e": 127.796,
   "text": "Haberlerde kimse bundan bahsetmiyordu. Henüz.",
   "hl": {
    "henüz.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L34",
   "sc": "masa2",
   "v": "CINAR",
   "s": 127.996,
   "e": 131.434,
   "text": "Kimse fark etmeden hazırlanırsak, herkesten önde oluruz.",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR",
   "pre": 0.12
  },
  {
   "id": "L35",
   "sc": "masa2",
   "v": "N",
   "s": 131.634,
   "e": 134.603,
   "text": "Ama bu, herkesi kendi kaderine bırakmak demekti.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L36",
   "sc": "secim",
   "v": "N",
   "s": 134.803,
   "e": 137.884,
   "text": "Sessizce hazırlanıyor musun, yoksa herkesi uyarıyor musun?",
   "hl": {
    "sessizce": "y",
    "uyarıyor": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  }
