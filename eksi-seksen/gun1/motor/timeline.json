{
 "duration": 97.721,
 "fps": 30,
 "lines": [
  {
   "id": "L01",
   "sc": "yatak",
   "v": "N",
   "s": 1.0,
   "e": 4.914,
   "text": "On sekiz Aralık sabahı, Çankaya'daki çatı katında alarmın çaldı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L02",
   "sc": "yatak",
   "v": "N",
   "s": 5.114,
   "e": 8.634,
   "text": "Otuz üç yaşındaydın. Şirketini milyonlarca dolara satmıştın.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L03",
   "sc": "yatak",
   "v": "N",
   "s": 8.834,
   "e": 12.964,
   "text": "Ama o sabah telefon eksi bir dereceyi gösteriyordu. Dün artı ondu.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L04",
   "sc": "mutfak",
   "v": "N",
   "s": 13.224,
   "e": 14.203,
   "text": "Televizyonu açtın.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L05",
   "sc": "tv_haber",
   "v": "SPIKER",
   "s": 14.753,
   "e": 18.171,
   "text": "Sibirya kaynaklı soğuk hava dalgası etkisini artırıyor.",
   "hl": {},
   "col": null,
   "etiket": "HABER",
   "pre": 0.12
  },
  {
   "id": "L06",
   "sc": "mutfak2",
   "v": "N",
   "s": 18.371,
   "e": 20.711,
   "text": "Kış işte, dedin. Ankara'nın ayazı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L07",
   "sc": "park",
   "v": "N",
   "s": 20.991,
   "e": 25.484,
   "text": "Kuğulu Park'ta havuz buz tutmuştu. Güneş tepedeydi ama ısıtmıyordu.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L08",
   "sc": "telefon_app",
   "v": "N",
   "s": 25.744,
   "e": 32.303,
   "text": "Öğlen hava durumu uygulaması tuhaf rakamlar gösterdi. Eksi on. Eksi yirmi dört. Eksi otuz iki.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L09",
   "sc": "kafe2",
   "v": "N",
   "s": 32.503,
   "e": 34.76,
   "text": "Kafedekiler güldü. Uygulama bozulmuş.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L10",
   "sc": "haber_bandi",
   "v": "N",
   "s": 35.02,
   "e": 40.133,
   "text": "Haber bandında: Avrupa'da, Asya'da, Amerika'da aynı anda ani soğuma.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L11",
   "sc": "eczane",
   "v": "N",
   "s": 40.333,
   "e": 42.779,
   "text": "Soğuk hava dalgası her yere aynı anda gelmez.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L12",
   "sc": "tel_aras",
   "v": "N",
   "s": 43.039,
   "e": 44.201,
   "text": "Ortağın Aras'ı aradın.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L13",
   "sc": "tel_aras",
   "v": "ARAS",
   "s": 44.801,
   "e": 50.035,
   "text": "Kanka, gökyüzü masmavi ama paneller yarı yarıya üretiyor. Güneş sanki kısılmış.",
   "hl": {},
   "col": null,
   "etiket": "ARAS · TELEFON",
   "pre": 0.12
  },
  {
   "id": "L14",
   "sc": "ciftlik",
   "v": "N",
   "s": 50.295,
   "e": 55.147,
   "text": "Kızılcahamam'daki çiftliği satmamıştın. Türbinler, seralar, kocaman bir depo.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L15",
   "sc": "foto",
   "v": "N",
   "s": 55.347,
   "e": 58.605,
   "text": "Aras, Çınar ve sen. Üçünüzün de kimsesi yok.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L16",
   "sc": "kapi",
   "v": "N",
   "s": 59.155,
   "e": 62.469,
   "text": "Akşam Çınar elinde poşetler ve düdüklü tencereyle geldi.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L17",
   "sc": "mutfak_aksam",
   "v": "N",
   "s": 62.669,
   "e": 65.351,
   "text": "Mercimek çorbası kaynarken Aras görüntülü aradı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L18",
   "sc": "grafik",
   "v": "ARAS",
   "s": 65.551,
   "e": 69.092,
   "text": "Bütün gün ölçtüm. Gelen ışık her saat biraz daha azalıyor.",
   "hl": {},
   "col": null,
   "etiket": "ARAS · GÖRÜNTÜLÜ",
   "pre": 0.12
  },
  {
   "id": "L19",
   "sc": "hesap",
   "v": "N",
   "s": 69.352,
   "e": 73.931,
   "text": "Bugün on bir derece düştü. Yarın belki dokuz, belki on dört. Ama hep aşağı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L20",
   "sc": "aras_video",
   "v": "ARAS",
   "s": 74.191,
   "e": 75.788,
   "text": "Bu bir hava olayı değil kanka.",
   "hl": {},
   "col": null,
   "etiket": "ARAS · GÖRÜNTÜLÜ",
   "pre": 0.12
  },
  {
   "id": "L21",
   "sc": "masa2",
   "v": "CINAR",
   "s": 76.068,
   "e": 79.146,
   "text": "Kimse fark etmeden hazırlanırsak herkesten önde oluruz.",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR",
   "pre": 0.12
  },
  {
   "id": "L22",
   "sc": "masa2",
   "v": "N",
   "s": 79.346,
   "e": 82.557,
   "text": "Ama bu, herkesi kendi kaderine bırakmak demekti.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L23",
   "sc": "secim",
   "v": "N",
   "s": 82.857,
   "e": 86.811,
   "text": "Sessizce hazırlanıyor musun, yoksa herkesi uyarıyor musun?",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L24",
   "sc": "secim",
   "v": "N",
   "s": 87.111,
   "e": 91.683,
   "text": "Susarsan kilerin dört ay yeter. Ama bir gün biri sana, biliyordun, diyecek.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L25",
   "sc": "secim",
   "v": "N",
   "s": 91.943,
   "e": 95.621,
   "text": "Uyarırsan birkaç kişi kurtulur. Ama paniği sen başlatırsın.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  }
 ],
