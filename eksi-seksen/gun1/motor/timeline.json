{
 "duration": 150.542,
 "fps": 30,
 "lines": [
  {
   "id": "L01",
   "sc": "yatak",
   "v": "N",
   "s": 0.2,
   "e": 3.578,
   "text": "On sekiz Aralık sabahı, Çankaya'daki çatı katında alarmın çaldı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L02",
   "sc": "yatak",
   "v": "N",
   "s": 3.818,
   "e": 9.725,
   "text": "Otuz üç yaşındaydın. Kurduğun şirketi milyonlarca dolara satmıştın. Bir daha çalışmana gerek yoktu.",
   "hl": {
    "milyonlarca": "y",
    "dolara": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L03",
   "sc": "yatak",
   "v": "N",
   "s": 10.005,
   "e": 15.375,
   "text": "Ama o sabah yerler buz gibiydi. Telefon sıfır dereceyi gösteriyordu. Dün artı ondu.",
   "hl": {
    "sıfır": "y",
    "artı": "y",
    "ondu.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L04",
   "sc": "mutfak",
   "v": "N",
   "s": 15.615,
   "e": 17.267,
   "text": "Kahveni alıp televizyonu açtın.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L05",
   "sc": "tv_haber",
   "v": "SPIKER",
   "s": 18.207,
   "e": 21.625,
   "text": "Sibirya kaynaklı soğuk hava dalgası etkisini artırıyor.",
   "hl": {},
   "col": null,
   "etiket": "HABER",
   "pre": 0.12
  },
  {
   "id": "L06",
   "sc": "mutfak2",
   "v": "N",
   "s": 21.865,
   "e": 24.428,
   "text": "Kış işte, dedin. Ankara'nın ayazı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L07",
   "sc": "park",
   "v": "N",
   "s": 24.748,
   "e": 28.551,
   "text": "Kuğulu Park'ta havuz buz tutmuştu. Ağaçlarda tek bir kuş yoktu.",
   "hl": {
    "kuş": "r",
    "yoktu.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L08",
   "sc": "park",
   "v": "N",
   "s": 28.791,
   "e": 33.089,
   "text": "Güneş tepedeydi ama ısıtmıyordu. Soluk, eski bir ampul gibiydi.",
   "hl": {
    "ısıtmıyordu.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L09",
   "sc": "kafe",
   "v": "N",
   "s": 33.409,
   "e": 36.415,
   "text": "Öğlen Tunalı'da bir kafede herkes soğuktan bahsediyordu.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L10",
   "sc": "telefon_app",
   "v": "N",
   "s": 36.615,
   "e": 42.822,
   "text": "Hava durumu uygulaması tuhaf rakamlar gösteriyordu. Eksi on. Eksi yirmi. Eksi otuz.",
   "hl": {
    "eksi": "r",
    "on.": "r",
    "yirmi.": "r",
    "otuz.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L11",
   "sc": "kafe2",
   "v": "N",
   "s": 43.102,
   "e": 45.744,
   "text": "Masadakiler güldü. Uygulama bozulmuş.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L12",
   "sc": "eczane",
   "v": "N",
   "s": 46.064,
   "e": 50.642,
   "text": "Saat birde termometre hâlâ sıfırdı. Öğlen bile bir derece yükselmemişti.",
   "hl": {
    "sıfırdı.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L13",
   "sc": "haber_bandi",
   "v": "N",
   "s": 50.882,
   "e": 56.825,
   "text": "Haber bandında bir satır geçti: Avrupa'da, Asya'da, Amerika'da aynı anda ani soğuma.",
   "hl": {
    "aynı": "r",
    "anda": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L14",
   "sc": "haber_bandi",
   "v": "N",
   "s": 57.065,
   "e": 60.625,
   "text": "Soğuk hava dalgası dünyanın her yerine aynı anda gelmez.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L15",
   "sc": "tel_aras",
   "v": "N",
   "s": 60.945,
   "e": 65.884,
   "text": "Aras'ı aradın. Şirketi birlikte kurduğunuz mühendis. Kızılcahamam'daki çiftlikte yaşıyor.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L16",
   "sc": "tel_aras",
   "v": "ARAS",
   "s": 66.924,
   "e": 71.309,
   "text": "Kanka, burada da sıfır. Dün on ikiydi. Bir de garip bir şey var.",
   "hl": {},
   "col": null,
   "etiket": "ARAS · TELEFON",
   "pre": 0.12
  },
  {
   "id": "L17",
   "sc": "tel_aras",
   "v": "ARAS",
   "s": 71.509,
   "e": 76.882,
   "text": "Gökyüzü masmavi ama güneş panelleri yarı yarıya az üretiyor. Güneş sanki kısılmış.",
   "hl": {
    "kısılmış.": "r"
   },
   "col": null,
   "etiket": "ARAS · TELEFON",
   "pre": 0.12
  },
  {
   "id": "L18",
   "sc": "ciftlik",
   "v": "N",
   "s": 77.202,
   "e": 83.574,
   "text": "Şirketi satarken deneme çiftliğini satmamıştın. Rüzgâr türbinleri, seralar, kocaman bir depo. Hepsi senindi.",
   "hl": {
    "senindi.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L19",
   "sc": "foto",
   "v": "N",
   "s": 83.814,
   "e": 88.862,
   "text": "Aras, Çınar ve sen. Üçünüzün de kimsesi yok. Sadece birbiriniz varsınız.",
   "hl": {
    "birbiriniz": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L20",
   "sc": "tel_cinar",
   "v": "N",
   "s": 89.182,
   "e": 90.062,
   "text": "Çınar'ı aradın.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L21",
   "sc": "tel_cinar",
   "v": "CINAR",
   "s": 91.002,
   "e": 94.619,
   "text": "Kanka, ben de tam seni arayacaktım. Bu soğuk normal değil, değil mi?",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR · TELEFON",
   "pre": 0.12
  },
  {
   "id": "L22",
   "sc": "kapi",
   "v": "N",
   "s": 95.659,
   "e": 100.287,
   "text": "Akşam yedide Çınar kapıdaydı. Elinde iki poşet, bir de düdüklü tencere.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L23",
   "sc": "kapi",
   "v": "CINAR",
   "s": 100.487,
   "e": 104.362,
   "text": "Senin buzdolabında yumurtayla yoğurttan başka bir şey olmadığını biliyorum.",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR",
   "pre": 0.12
  },
  {
   "id": "L24",
   "sc": "mutfak_aksam",
   "v": "N",
   "s": 104.682,
   "e": 108.596,
   "text": "Mercimek çorbasının kokusu evi sardı. Aras görüntülü aramadaydı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L25",
   "sc": "tv_aksam",
   "v": "N",
   "s": 108.836,
   "e": 114.152,
   "text": "Haberler hâlâ soğuk hava dalgası diyordu. Ama Aras'ın grafiği başka bir şey söylüyordu.",
   "hl": {
    "grafiği": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L26",
   "sc": "grafik",
   "v": "ARAS",
   "s": 114.392,
   "e": 121.062,
   "text": "Çiftliğin hava istasyonu bütün gün güneşi ölçtü. Gelen ışık normalin yarısı. Ve her saat azalıyor.",
   "hl": {
    "yarısı.": "r",
    "azalıyor.": "r"
   },
   "col": null,
   "etiket": "ARAS · GÖRÜNTÜLÜ",
   "pre": 0.12
  },
  {
   "id": "L27",
   "sc": "masa",
   "v": "CINAR",
   "s": 121.382,
   "e": 122.671,
   "text": "Güneş azalırsa ne olur?",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR",
   "pre": 0.12
  },
  {
   "id": "L28",
   "sc": "hesap",
   "v": "N",
   "s": 122.991,
   "e": 127.02,
   "text": "Hesabı yüksek sesle yaptın. Güneş kısılırsa dünya her gün biraz daha soğur.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L29",
   "sc": "hesap",
   "v": "N",
   "s": 127.22,
   "e": 130.243,
   "text": "Bugün on derece düştü. Yarın bir on derece daha.",
   "hl": {
    "yarın": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L30",
   "sc": "aras_video",
   "v": "ARAS",
   "s": 130.563,
   "e": 132.114,
   "text": "Bu bir hava olayı değil kanka.",
   "hl": {},
   "col": null,
   "etiket": "ARAS · GÖRÜNTÜLÜ",
   "pre": 0.12
  },
  {
   "id": "L31",
   "sc": "tv_aksam2",
   "v": "N",
   "s": 132.434,
   "e": 135.038,
   "text": "Haberlerde kimse bundan bahsetmiyordu. Henüz.",
   "hl": {
    "henüz.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L32",
   "sc": "masa2",
   "v": "CINAR",
   "s": 135.358,
   "e": 138.537,
   "text": "Kimse fark etmeden hazırlanırsak, herkesten önde oluruz.",
   "hl": {},
   "col": null,
   "etiket": "ÇINAR",
   "pre": 0.12
  },
  {
   "id": "L33",
   "sc": "masa2",
   "v": "N",
   "s": 138.777,
   "e": 141.806,
   "text": "Ama bu, herkesi kendi kaderine bırakmak demekti.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L34",
   "sc": "secim",
   "v": "N",
   "s": 142.166,
   "e": 145.542,
   "text": "Sessizce hazırlanıyor musun, yoksa herkesi uyarıyor musun?",
   "hl": {
    "sessizce": "y",
    "uyarıyor": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  }
 ],
