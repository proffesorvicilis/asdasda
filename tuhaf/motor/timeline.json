   "v": "MOSS",
   "s": 3.329,
   "e": 5.867,
   "text": "Yedi gece!",
   "hl": {
    "yedi": "y"
   },
   "col": null,
   "etiket": "MOSS",
   "pre": 0.12
  },
  {
   "id": "L03",
   "sc": "iskele",
   "v": "MOSS",
   "s": 6.167,
   "e": 8.555,
   "text": "Sabah gelirim, evlat!",
   "hl": {},
   "col": null,
   "etiket": "MOSS",
   "pre": 0.12
  },
  {
   "id": "L04",
   "sc": "iskele",
   "v": "MOSS",
   "s": 8.855,
   "e": 10.407,
   "text": "Gece asla!",
   "hl": {
    "asla!": "r"
   },
   "col": null,
   "etiket": "MOSS",
   "pre": 0.12
  },
  {
   "id": "L05",
   "sc": "kapi",
   "v": "N",
   "s": 11.807,
   "e": 15.796,
   "text": "Son bekçi Harlan, bu ışığı otuz yıl boyunca yaktı.",
   "hl": {
    "harlan,": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.75
  },
  {
   "id": "L06",
   "sc": "kapi",
   "v": "N",
   "s": 16.196,
   "e": 18.906,
   "text": "Bir ay önce... ortadan kayboldu.",
   "hl": {
    "kayboldu.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L07",
   "sc": "masa",
   "v": "N",
   "s": 19.706,
   "e": 22.051,
   "text": "Kuralları hâlâ duvarda asılıydı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L08",
   "sc": "kurallar",
   "v": "N",
   "s": 22.651,
   "e": 27.615,
   "text": "Birinci kural: Işık, alacakaranlıktan şafağa kadar yanmalı. Her zaman.",
   "hl": {
    "her": "y",
    "zaman.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L09",
   "sc": "kurallar",
   "v": "N",
   "s": 28.115,
   "e": 32.639,
   "text": "İkinci kural: Gece üçten sonra telsize asla cevap verme.",
   "hl": {
    "asla": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L10",
   "sc": "kurallar",
   "v": "N",
   "s": 33.139,
   "e": 37.342,
   "text": "Üçüncü kural: Geceleri adaya kimse gelmez. Kimse.",
   "hl": {
    "kimse": "r",
    "kimse.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L11",
   "sc": "kurallar",
   "v": "N",
   "s": 37.842,
   "e": 43.119,
   "text": "Dördüncü kural: Lambaya doksan dokuz basamak var. Yüz sayarsan... aşağı in.",
   "hl": {
    "doksan": "y",
    "dokuz": "y",
    "yüz": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L12",
   "sc": "kurallar",
   "v": "N",
   "s": 43.819,
   "e": 47.169,
   "text": "Beşinci kuralın üstü karalanmıştı. Sertçe.",
   "hl": {
    "beşinci": "y",
    "sertçe.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L13",
   "sc": "merdiven",
   "v": "N",
   "s": 48.069,
   "e": 50.696,
   "text": "Doksan dokuz basamak. Say onları.",
   "hl": {
    "doksan": "y",
    "dokuz": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L14",
   "sc": "merdiven",
   "v": "N",
   "s": 51.296,
   "e": 52.965,
   "text": "Harlan hep sayardı.",
   "hl": {
    "harlan": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
