 "lines": [
  {
   "id": "L01",
   "sc": "ada",
   "v": "N",
   "s": 0.2,
   "e": 2.32,
   "text": "Kimsenin istemediği işi sen aldın.",
   "hl": {
    "kimsenin": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L02",
   "sc": "iskele",
   "v": "MOSS",
   "s": 2.67,
   "e": 6.245,
   "text": "Yedi gece! Sabah dönerim, evlat! Gece asla gelmem!",
   "hl": {
    "yedi": "y",
    "asla": "r"
   },
   "col": null,
   "etiket": "MOSS",
   "pre": 0.12
  },
  {
   "id": "L05",
   "sc": "kapi",
   "v": "N",
   "s": 6.745,
   "e": 10.176,
   "text": "Önceki bekçi Harlan, bu ışığı otuz yıl boyunca yaktı.",
   "hl": {
    "harlan,": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.45
  },
  {
   "id": "L06",
   "sc": "kapi",
   "v": "N",
   "s": 10.376,
   "e": 12.786,
   "text": "Bir ay önce... ortadan kayboldu.",
   "hl": {
    "kayboldu.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L07",
   "sc": "masa",
   "v": "N",
   "s": 13.186,
   "e": 15.276,
   "text": "Kuralları hâlâ duvarda asılıydı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L08",
   "sc": "kurallar",
   "v": "N",
   "s": 15.526,
   "e": 19.927,
   "text": "Birinci kural: Işık, alacakaranlıktan şafağa kadar yanmalı. Her zaman.",
   "hl": {
    "her": "y",
    "zaman.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L09",
   "sc": "kurallar",
   "v": "N",
   "s": 20.127,
   "e": 24.144,
   "text": "İkinci kural: Gece üçten sonra telsize asla cevap verme.",
   "hl": {
    "asla": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L10",
   "sc": "kurallar",
   "v": "N",
   "s": 24.344,
   "e": 28.082,
   "text": "Üçüncü kural: Geceleri adaya kimse gelmez. Kimse.",
   "hl": {
    "kimse": "r",
    "kimse.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L11",
   "sc": "kurallar",
   "v": "N",
   "s": 28.282,
   "e": 33.692,
   "text": "Dördüncü kural: Lambaya kadar doksan dokuz basamak var. Yüz sayarsan... aşağı in.",
   "hl": {
    "doksan": "y",
    "dokuz": "y",
    "yüz": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L12",
   "sc": "kurallar",
   "v": "N",
   "s": 33.992,
   "e": 36.811,
   "text": "Beşinci kural karalanmıştı. Bastıra bastıra.",
   "hl": {
    "beşinci": "y",
    "bastıra": "r",
    "bastıra.": "r"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L13",
   "sc": "merdiven",
   "v": "N",
   "s": 37.161,
   "e": 39.505,
   "text": "Doksan dokuz basamak. Say onları.",
   "hl": {
    "doksan": "y",
    "dokuz": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L14",
   "sc": "merdiven",
   "v": "N",
   "s": 39.755,
   "e": 41.24,
   "text": "Harlan hep sayardı.",
   "hl": {
    "harlan": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L15",
   "sc": "lamba",
   "v": "N",
   "s": 41.64,
   "e": 42.741,
   "text": "Alacakaranlık.",
   "hl": {
    "alacakaranlık.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L16",
   "sc": "lamba",
   "v": "N",
   "s": 42.891,
   "e": 43.74,
   "text": "Işık yandı.",
   "hl": {
    "yandı.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L17",
   "sc": "defter",
   "v": "N",
   "s": 44.24,
   "e": 47.641,
   "text": "Bunu deftere yazıyorsun, Harlan'ın yaptığı gibi. Her gece.",
   "hl": {
    "her": "y",
    "gece.": "y"
   },
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
