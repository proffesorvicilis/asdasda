 "lines": [
  {
   "id": "L01",
   "sc": "masa_sessiz",
   "v": "N",
   "s": 0.2,
   "e": 1.771,
   "text": "Sessiz kalmayı seçtin.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L02",
   "sc": "telsiz_acilir",
   "v": "N",
   "s": 2.271,
   "e": 5.008,
   "text": "Üçü beş geçe, telsiz kendi kendine açıldı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L03",
   "sc": "telsiz_acilir",
   "v": "KADIN",
   "s": 5.508,
   "e": 7.218,
   "text": "Beni duyduğunu biliyorum.",
   "hl": {},
   "col": null,
   "etiket": "TELSİZ · KANAL 16",
   "pre": 0.12
  },
  {
   "id": "L04",
   "sc": "masa_sessiz2",
   "v": "N",
   "s": 7.818,
   "e": 9.607,
   "text": "Sonra... hiçbir şey.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L05",
   "sc": "gemi",
   "v": "N",
   "s": 10.207,
   "e": 13.886,
   "text": "Dördü on geçe, bir yük gemisi kayaların yanından geçti. Sağ salim.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L06",
   "sc": "gunduz",
   "v": "N",
   "s": 14.686,
   "e": 16.575,
   "text": "Öğle vakti telsiz güvenli.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L07",
   "sc": "gunduz",
   "v": "N",
   "s": 16.825,
   "e": 18.596,
   "text": "Moss'a Marigold'u sordun.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L08",
   "sc": "moss_telsiz",
   "v": "MOSS",
   "s": 19.096,
   "e": 20.875,
   "text": "Marigold mu?",
   "hl": {},
   "col": null,
   "etiket": "MOSS · TELSİZ",
   "pre": 0.12
  },
  {
   "id": "L09",
   "sc": "moss_telsiz",
   "v": "MOSS",
   "s": 21.275,
   "e": 25.27,
   "text": "Fırtınada motoru bozuldu. Sürüklenip kayalara çarptı.",
   "hl": {},
   "col": null,
   "etiket": "MOSS · TELSİZ",
   "pre": 0.12
  },
  {
   "id": "L10",
   "sc": "moss_telsiz",
   "v": "MOSS",
   "s": 25.62,
   "e": 28.959,
   "text": "Kimse kurtulamadı. On iki yıl önce.",
   "hl": {},
   "col": null,
   "etiket": "MOSS · TELSİZ",
   "pre": 0.12
  },
  {
   "id": "L11",
   "sc": "harlan_foto",
   "v": "MOSS",
   "s": 29.459,
   "e": 31.342,
   "text": "Harlan'ın kurallarına uy, evlat.",
   "hl": {},
   "col": null,
   "etiket": "MOSS · TELSİZ",
   "pre": 0.12
  },
  {
   "id": "L12",
   "sc": "gunluk",
   "v": "N",
   "s": 31.942,
   "e": 34.897,
   "text": "Harlan'ın günlüğü. Otuz yıl boyunca hep sakin.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L13",
   "sc": "gunluk",
   "v": "N",
   "s": 35.247,
   "e": 37.021,
   "text": "Sonra... son sayfa.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L14",
   "sc": "gunluk",
   "v": "N",
   "s": 37.521,
   "e": 41.578,
   "text": "O kadın artık her gece arıyor. Sadece onun bilebileceği şeyleri biliyor.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L15",
   "sc": "gunluk",
   "v": "N",
   "s": 41.978,
   "e": 45.472,
   "text": "Beşinci kural yanlış. Bu gece onu içeri alacağım.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L16",
   "sc": "lamba",
   "v": "N",
   "s": 48.622,
   "e": 50.848,
   "text": "Alacakaranlık. Işık yandı.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L17",
   "sc": "yatak",
   "v": "N",
   "s": 51.548,
   "e": 53.696,
   "text": "İkinci gece. Saat bir buçuk.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L18",
   "sc": "kapi_ic",
   "v": "N",
   "s": 54.096,
   "e": 55.437,
   "text": "Biri kapıyı çalıyor.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L19",
   "sc": "kapi_bekci",
   "v": "KAPI",
   "s": 57.787,
   "e": 59.834,
   "text": "Lütfen... benim.",
   "hl": {},
   "col": null,
   "etiket": "KAPIDA",
   "pre": 0.12
  },
  {
   "id": "L20",
   "sc": "kapi_bekci",
   "v": "KAPI",
   "s": 60.184,
   "e": 61.869,
   "text": "Beni içeri al. Çok üşüyorum.",
   "hl": {},
   "col": null,
   "etiket": "KAPIDA",
   "pre": 0.12
  },
  {
   "id": "L21",
   "sc": "harlan_kasket",
   "v": "N",
   "s": 62.669,
   "e": 64.284,
   "text": "O kasketi tanıyorsun.",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  },
  {
   "id": "L22",
   "sc": "kural3",
   "v": "KAPI",
   "s": 64.984,
   "e": 68.062,
   "text": "Yaşlı bir adamı donmaya bırakmazsın... değil mi?",
   "hl": {},
   "col": null,
   "etiket": "KAPIDA",
   "pre": 0.12
  },
  {
   "id": "L23",
   "sc": "secim",
   "v": "N",
   "s": 68.762,
   "e": 70.044,
   "text": "Kapıyı açıyor musun?",
   "hl": {},
   "col": null,
   "etiket": null,
   "pre": 0.12
  }
